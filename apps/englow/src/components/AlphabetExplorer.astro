---

<div class="alphabet-wrapper not-content">
  <div class="alphabet-filters" id="alphabet-filters">
    <button class="alphabet-filter-btn active" data-filter="all">
      {isUk ? 'Всі 26 літер' : 'All 26 Letters'}
    </button>
    <button class="alphabet-filter-btn" data-filter="vowel">
      {isUk ? 'Голосні (5)' : 'Vowels (5)'}
    </button>
    <button class="alphabet-filter-btn" data-filter="consonant">
      {isUk ? 'Приголосні (16)' : 'Consonants (16)'}
    </button>
    <button class="alphabet-filter-btn" data-filter="special">
      {isUk ? 'Особливі звуки (5)' : 'Special Sounds (5)'}
    </button>
  </div>

  <div class="alphabet-grid" id="alphabet-grid">
    {letters.map((item) => (
      <div class="letter-card" data-category={item.category}>
        <div class="letter-card-header">
          <div class="letter-main">{item.letter}</div>
          <span class="letter-sound-badge">{item.ipa}</span>
        </div>

        <div class="letter-name-tag">{item.name}</div>

        <div class={`letter-type-pill type-${item.category}`}>
          {isUk ? item.categoryLabelUk : item.categoryLabelEn}
        </div>

        <div class="letter-words-list">
          {item.words.map((w) => (
            <div class="word-row">
              <span class="word-english">{w.word}</span>
              <span class="word-ipa">{w.ipa}</span>
              <span class="word-meaning">{isUk ? w.ua : w.en}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.alphabet-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.letter-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const matches = filter === 'all' || card.getAttribute('data-category') === filter;
        if (matches) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });
    });
  });
</script>
